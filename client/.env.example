# Cesium Ion Access Token
# Get your free token at https://ion.cesium.com/tokens
VITE_CESIUM_ION_TOKEN=your_token_here

# The project's data folder.
# ChemDuck project: every table as parquet, plus sql/ (server/sync_chemduck.py).
VITE_DATA_URL=http://localhost:8000/data

# EQuIS ARII project (optional): the export pipeline's manifest.json. When set,
# VITE_DATA_URL is the folder server/publish_arii.py wrote, and results are read
# from the manifest's partitions by HTTP range requests. A SAS token may follow
# the manifest URL's `?`; it is appended to each partition URL.
# VITE_ARII_MANIFEST_URL=https://<account>.blob.core.windows.net/<container>/<facility>/manifest.json
