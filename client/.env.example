# Cesium Ion Access Token
# Get your free token at https://ion.cesium.com/tokens
VITE_CESIUM_ION_TOKEN=your_token_here

# The project's data folder.
# ChemDuck project: every table as parquet, plus sql/ (server/sync_chemduck.py).
VITE_DATA_URL=http://localhost:8000/data

# EQuIS ARII project (optional): the export pipeline's manifest.json. Results are
# read from the manifest's partitions by HTTP range requests. VITE_DATA_URL is
# the folder server/publish_arii.py wrote; leave it unset if that is chemrooms/
# beside the manifest. A SAS token may follow the manifest URL's `?`; it is
# reused for the sidecars and every partition.
#
# Leave both unset in a production build to get the connect screen, or open
# any project at runtime with #manifest=<url> / #data=<url> (see README.md).
# VITE_ARII_MANIFEST_URL=https://<account>.blob.core.windows.net/<container>/<facility>/manifest.json
